# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
TMDB_API_KEY=your_tmdb_api_key_here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# LLM provider for reflection/discovery chat (D5, D33). "mock" is deterministic
# and needs no API key. "openai" uses the real model and needs the two values
# below. On deployment, set these three as environment variables in the
# hosting platform's settings — never commit a real key.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
