# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
TMDB_API_KEY=your_tmdb_api_key_here
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# LLM provider for reflection/discovery chat (D5). "mock" is deterministic and
# needs no API key; real providers slot in behind the same interface later.
LLM_PROVIDER=mock
